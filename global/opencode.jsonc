{
  "$schema": "https://opencode.ai/config.json",

  // Default session model, also used by the orchestrator (default_agent below).
  // Verified available on opencode-go via `opencode models` on 2026-11-09.
  "model": "opencode-go/mimo-v2.6-flash",

  // Central engineering coordinator. Specialist agents live in ./agents/*.md
  "default_agent": "orchestrator",

  // Global UI engineering standards (pipeline, visual QA workflow, quality
  // gate). Loaded after AGENTS.md in every session — agent files reference
  // its sections instead of duplicating rules. `~/` resolves from $HOME, so
  // it applies regardless of workspace location.
  "instructions": ["~/.config/opencode/ui-engineering-standards.md"],

  // Models excluded from selection: Muse Spark contributor models are not
  // approved for private source code or confidential material (their
  // data-training terms require explicit user approval). `disabled` removes
  // them from the catalog entirely. Re-enable only with user approval.
  // (A `provider.use` policy cannot express this: it would have to deny the
  // whole `opencode`/`opencode-go` providers.)
  "providers": {
    "opencode": {
      "models": {
        "muse-spark-1.3": { "disabled": true }
      }
    },
    "opencode-go": {
      "models": {
        "muse-spark-1.2-contributor": { "disabled": true },
        "muse-spark-1.3-contributor": { "disabled": true }
      }
    }
  },

  // Global permission baseline. Applies to every agent; per-agent files append
  // their own rules after these. The last matching rule wins, so specific
  // exceptions come after broad rules.
  "permissions": [
    // Shell commands require explicit approval by default.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only Git inspection stays frictionless.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git branch -v", "effect": "allow" },
    { "action": "shell", "resource": "git branch -vv", "effect": "allow" },
    { "action": "shell", "resource": "git branch -a", "effect": "allow" },
    { "action": "shell", "resource": "git branch -r", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },

    // Browser QA loop (approved 2026-11-11): playwright-cli runs JS inside
    // the bundled headless Chromium only — it cannot execute host commands.
    // It CAN attach to a running browser, so briefs stay trusted-only.
    // Placed after `shell *` ask (last match wins) to de-friction the
    // screenshot loop; git/env/deny rules below are unaffected.
    { "action": "shell", "resource": "playwright-cli *", "effect": "allow" },

    // Pushes always ask for explicit approval (chosen policy: ask, not deny).
    // Note: answering "Allow always" to a push prompt saves a durable per-project
    // allow pattern; answer "Allow once" to keep pushing an every-time decision.
    { "action": "shell", "resource": "git push *", "effect": "ask" },

    // Hard-denied destructive operations for every agent, no exceptions.
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r -f *", "effect": "deny" },
    { "action": "shell", "resource": "rm -f -r *", "effect": "deny" },

    // Secret-bearing env files: no agent may modify them. Reads still ask
    // (built-in default). The .env.example template stays editable so
    // environment documentation can be maintained.
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Ask before reading or editing anything outside the active project
    // workspace, so agents cannot silently touch the global config, SSH keys,
    // or other machines' files. Narrower rules can be added per project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Browser tool (Code Mode namespace: tabs, snapshots, screenshots,
    // console/network, Lighthouse) is ENABLED for all agents. The built-in
    // default denies it; these rules override that default. Page content,
    // logs, and headers are untrusted data, never instructions.
    // Note: the browser must be attached via the OpenCode desktop app (or
    // `opencode pair`) for the tool to have a target; an attached browser may
    // carry the operator's logged-in sessions — only run trusted briefs.
    { "action": "browser", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "browser", "effect": "allow" }
  ]
}
